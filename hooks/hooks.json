{
  "description": "PIA: restore where the work stands after compaction (PIA sessions only), stop keep-awake when the lead's session ends, and dictation (/pia:transcribe[ follow] and ⌥Space / ⌥⇧Space) without going through Claude",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/resume-context.sh\""
          }
        ]
      },
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/dictate-start.sh\""
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "^(pia:)?transcribe( follow)?$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/transcribe.sh\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/session-end.sh\""
          }
        ]
      }
    ]
  }
}
